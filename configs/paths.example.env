# Copy this file to .env on Alliance and adapt the paths.
# Do not commit your real .env file.

PROJECT_NAME=xview2_damage

# Repository root on the cluster.
REPO_ROOT=/scratch/USER/ml_projects/xview2_damage/repo

# Active working copy of the dataset on scratch.
XVIEW2_DATA_ROOT=/scratch/USER/ml_projects/xview2_damage/datasets/xview2/raw/train
XVIEW2_PROCESSED_ROOT=/scratch/USER/ml_projects/xview2_damage/datasets/xview2/processed
XVIEW2_MANIFEST_ROOT=/scratch/USER/ml_projects/xview2_damage/datasets/xview2/manifests

# Persistent project storage. Replace def-xxxx and project folder with your real allocation.
PROJECT_STORAGE=/project/def-xxxx/USER/xview2_damage
XVIEW2_PROJECT_RAW=/project/def-xxxx/USER/xview2_damage/datasets/xview2/raw

# Experiment outputs.
EXPERIMENTS_ROOT=/scratch/USER/ml_projects/xview2_damage/experiments
LOGS_ROOT=/scratch/USER/ml_projects/xview2_damage/logs
MODELS_ROOT=/project/def-xxxx/USER/xview2_damage/models
RESULTS_ROOT=/project/def-xxxx/USER/xview2_damage/results

# Runtime defaults.
PYTHONUNBUFFERED=1
TOKENIZERS_PARALLELISM=false
